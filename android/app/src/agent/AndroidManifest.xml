<?xml version="1.0" encoding="utf-8"?>
<!-- agent flavor manifest：含 MediaProjection + 无障碍 + 前台服务权限。
     controller flavor 同名覆盖文件放 src/controller/AndroidManifest.xml，去掉敏感权限。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络（信令 + WebRTC ICE） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 被控端：屏幕共享（MediaProjection）、录制、音频 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 被控端：无障碍（默认零配置可用，点击/滑动/文本） -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <!-- 被控端：Shizuku（增强注入，可选） -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Rebleach Agent"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rebleach">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：持有 MediaProjection + MediaCodec，保证录屏存活 -->
        <service
            android:name=".agent.AgentForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 无障碍服务：点击/滑动/文本注入（可选，用户需手动在系统设置开启） -->
        <service
            android:name=".injection.RebleachAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
