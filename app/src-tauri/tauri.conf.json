{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rebleach Controller",
  "version": "0.2.4",
  "identifier": "com.rebleach.controller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rebleach 主控端",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/virtual-display/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Rebleach",
    "shortDescription": "Rebleach 主控端",
    "longDescription": "Rebleach 主控端：全 Rust 核心的开源远程桌面，WebRTC P2P 传输 + H.264 硬编硬解。",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFENzg5QTA4OTUxQzkzQTMKUldTamt4eVZDSnA0clRydUNTdllCQXhUQWc2RzJqSHNZYmlGWlluL0lnRnFyUmNZM2NFQ2JKbEkK",
      "endpoints": ["https://updates.example.com/api/v1/updater/download/updater-manifest-controller.json"],
      "dangerousInsecureTransportProtocol": true,
      "windows": { "installMode": "passive" }
    }
  }
}
